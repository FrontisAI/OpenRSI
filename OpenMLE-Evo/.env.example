# OpenAI-compatible model endpoint. For SGLang, use its --served-model-name and
# already-running /v1 service URL; the model-weight path belongs to SGLang only.
OPENMLE_MODEL_ID=Qwen/Qwen3-30B-A3B-Thinking-2507
SGLANG_BASE_URL=http://127.0.0.1:30010/v1
PRIMARY_KEY=EMPTY
OPENMLE_MAX_TOKENS=32768
OPENMLE_LLM_TIMEOUT=600
OPENMLE_LLM_RETRIES=1
AIRA_LITELLM_STREAM=0
AIRA_LITELLM_NUM_RETRIES=1

# Evaluation manifest and benchmark assets.
OPENMLE_EVAL_DATA=/absolute/path/to/eval.parquet
OPENMLE_LEADERBOARD_DIR=/absolute/path/to/leaderboards
OPENMLE_SUBMIT_DATA_DIR_ROOT=/absolute/path/to/prepared/tasks
OPENMLE_SUBMIT_DIR=MLTasks/MLE-Bench-Lite-Modified
OPENMLE_EVALUATION_PROTOCOL=self_valid

# Standard mode uses SANDBOX_URL directly.
SANDBOX_URL=http://sandbox.example:6580

# Multi-GPU mode submits concurrent jobs through SANDBOX_ROUTER_URL.
SANDBOX_ROUTER_URL=http://sandbox-router.example:6591
AIRAEVO_WORKERS=8

# The CPU and GPU services may use different keys.
SANDBOX_CPU_API_KEY=replace-me
SANDBOX_GPU_API_KEY=replace-me

# Optional concurrency and timeout overrides.
SANDBOX_CONCURRENCY=66
SANDBOX_PRIORITY=2
SANDBOX_JOB_TIMEOUT=7200
SANDBOX_WAIT_TIMEOUT=86400
SANDBOX_POLL_INTERVAL=10

# NatureBench Lite-v2 local assets and evaluator.
NATUREBENCH_ROOT=/absolute/path/to/NatureBench
NATUREBENCH_DATA_ROOT=/absolute/path/to/downloaded/naturebench-data
NATUREBENCH_TASKS_ROOT=naturebench
NATUREBENCH_TASK_SET_PATH=task-set/cpu.txt
NATUREBENCH_EVAL_SERVICE_URL=http://127.0.0.1:8321
NATUREBENCH_CONTAINER_EVAL_SERVICE_URL=http://host.docker.internal:8321
NATUREBENCH_DOCKER_IMAGE=cnsbench-base:v3
NATUREBENCH_WORKSPACE_ROOT=outputs/naturebench-staging
NATUREBENCH_BATCH_NAME=naturebench-airaevo
NATUREBENCH_LOCAL_PYTHON=/absolute/path/to/naturebench-local/bin/python
NATUREBENCH_LOCAL_CONDA_ENV=naturebench-local

# NatureBench SCM execution. The task root contains directories named by task ID.
NATUREBENCH_SCM_HOST=scm.example
NATUREBENCH_SCM_WORKSPACE_ROOT=/remote/path/to/airaevo-workspaces
NATUREBENCH_SCM_TASK_ROOT=/remote/path/to/naturebench-tasks
NATUREBENCH_SCM_EVAL_SERVICE_URL=http://localhost:8321
NATUREBENCH_SCM_GPU_DEVICES=0
NATUREBENCH_SCM_SHARED_GPU_DEVICE=0
NATUREBENCH_SCM_SHARED_GPU_SLOTS=1
NATUREBENCH_SCM_GPU_WAIT_TIMEOUT=3600
NATUREBENCH_EVAL_TIMEOUT=14400
NATUREBENCH_EXECUTION_TIMEOUT=14400
