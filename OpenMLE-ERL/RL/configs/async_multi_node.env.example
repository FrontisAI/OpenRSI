# Replace every /path/to, IP, container, or example.org value before precheck.

PROMPT_DATA="/path/to/openmle_rl_train.parquet"
EVAL_PROMPT_DATA="/path/to/openmle_rl_eval.parquet"
LEADERBOARD_ROOTS="/path/to/public_leaderboards"
REQUIRE_ALL_PUBLIC_LEADERBOARDS=1
MODEL_CONFIG="${OPS_DIR}/model_configs/qwen3.6-35B-A3B.sh"
HF_CHECKPOINT="/path/to/frontis_ma1_35b_hf"
REF_LOAD="/path/to/frontis_ma1_35b_megatron"
REF_CKPT_STEP=""

SANDBOX_MODE="remote"
SANDBOX_BASE_URL="https://sandbox.example.org"
SANDBOX_API_KEY="your-sandbox-api-key"
HF_ENDPOINT="https://hf-mirror.com"
GPT_BASE_URL="https://llm-api.example.org/v1"
GPT_API_KEY="your-gpt-api-key"
SANDBOX_CONCURRENCY=256
HACK_CHECK_CONCURRENCY=128
JOB_TIMEOUT=3600
WAIT_TIMEOUT=3600
EVAL_JOB_TIMEOUT=3600
EVAL_WAIT_TIMEOUT=3600
SANDBOX_MAX_JOB_TIMEOUT=3600
SANDBOX_MAX_WAIT_TIMEOUT=3900

OUTPUT_ROOT="${SLIME_ROOT}/outputs/openmle_rl"
WANDB_KEY="your-wandb-key"
WANDB_PROJECT="openmle-rl"
WANDB_MODE="online"
EXPERIMENT_ID="openmle_rl_async_multi_node"
NUM_ROLLOUT=3000
SAVE_INTERVAL=10
SAVE_DB_SNAPSHOTS=1
SLIME_DISABLE_SAVE=0

ROLLOUT_BATCH_SIZE=16
N_SAMPLES_PER_PROMPT=16
NUM_STEPS_PER_ROLLOUT=2
GLOBAL_BATCH_SIZE=128
ROLLOUT_MAX_RESPONSE_LEN=24576
EVAL_INTERVAL=5
N_SAMPLES_PER_EVAL_PROMPT=1
EVAL_MAX_RESPONSE_LEN=32768
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.95
EVAL_BEFORE_TRAIN=0
ALGO_VARIANT="gspo"
LR="1e-6"

ACTOR_NUM_NODES=1
ACTOR_NUM_GPUS_PER_NODE=8
ROLLOUT_NUM_GPUS=8
RAY_NUM_GPUS_PER_NODE=8
TENSOR_MODEL_PARALLEL_SIZE=2
PIPELINE_MODEL_PARALLEL_SIZE=1
CONTEXT_PARALLEL_SIZE=2
EXPERT_MODEL_PARALLEL_SIZE=8
ROLLOUT_NUM_GPUS_PER_ENGINE=4
SGLANG_MEM_FRACTION_STATIC=0.75
SOCKET_IFNAME="eth0"
MASTER_ADDR="192.0.2.1"
HOSTFILE="/path/to/hostfile"
RAY_PORT=6379
RAY_WORKER_SSH_USER="root"
RAY_WORKER_CONTAINER="openmle-worker"
RAY_WORKER_DOCKER_EXEC_OPTS=""
RAY_CLUSTER_WAIT_TIMEOUT=120
WAIT_FOR_RAY_CLUSTER=1
CLEANUP_EXISTING_RAY=0

REWARD_VARIANT="newreward"
TEMPERATURE=1
USE_SCORE2REWARD=1
REWARD_MAPPING_MODE="power_clip"
STATIC_REWARD_MAPPING_MODE="power_clip"
POWER_CLIP_ALPHA=1
ENABLE_DYNAMIC_SCORE_BOUNDS=1
ADAPTIVE_REWARD_BOUND_MODE="top1_top16"
ADAPTIVE_REWARD_BOUND_LOWER_SHIFT_RATIO=0.25
ADAPTIVE_BOUND_SINGLE_FINITE_REWARD_ONE=1
DYNAMIC_SCORE_BOUND_MIN_SPAN="1e-6"
USE_TTT_DISCOVER_ADVANTAGE=1
ENABLE_SELF_VALIDATION=0
IMPROVE_REWARD_STRATEGY="base"
IMPROVE_DELTA_BONUS_COEF=0.5
DRAFT_PROBABILITY=0.50
IMPROVE_PROBABILITY=0.17
DEBUG_PROBABILITY=0.17
CROSSOVER_PROBABILITY=0.16
SEARCH_ALGORITHM="airaevo"
AIRAEVO_POLICY="rl_mixed"
AIRAEVO_NUM_ISLANDS=5
AIRAEVO_MAX_ISLAND_SIZE=500
AIRAEVO_CROSSOVER_AFTER_GENERATION=0
AIRAEVO_EXECUTION_TIMEOUT=3600
AIRAEVO_RICH_MEMORY_ENABLED=1
AIRAEVO_RICH_MEMORY_MAX_TOKENS=512
AIRAEVO_RICH_MEMORY_TIMEOUT=60

# Diagnostics and Ray-propagated runtime controls
USE_PROXY_SANDBOX=0
ENABLE_PROMPT_DUMP=0
PROMPT_DUMP_BASE_DIR="${OUTPUT_ROOT}/prompt_dumps"
PROMPT_DUMP_RUN_SUBDIR=""
EVAL_GENERATION_ABORT_MAX_RETRIES=60
EVAL_GENERATION_ABORT_RETRY_SLEEP=1
AIRAEVO_MEMORY_LLM_URL=""
METRIC_STATIC_BOUND_USE_CONST_FALLBACK=1
METRIC_STATIC_FALLBACK_SIGNED_BEST=100
METRIC_STATIC_FALLBACK_SIGNED_WORST=-100
VALIDATION_TEST_GAP_PENALTY_PIECEWISE_ENABLED=1
VALIDATION_TEST_GAP_PENALTY_COEF=1
VALIDATION_TEST_GAP_PENALTY_HIGH_COEF=2
VALIDATION_TEST_GAP_PENALTY_TOLERANCE=0

RESUME_MODEL_PATH=""
RESUME_CKPT_STEP=""
LOAD_OPTIMIZER=0
LOAD_RNG=0
MANUAL_DB_PATH=""
